# The case's board, a Seeed XIAO ESP32C3. `idf.py set-target esp32s3` builds for the S3 test board instead;
# each board's own settings are in sdkconfig.defaults.<target>.
CONFIG_IDF_TARGET="esp32c3"

CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y

# Display: 2.4"/2.8" ILI9341 240x320 SPI module.
CONFIG_RAAH_LCD_ILI9341=y

# Power: DFS + automatic light sleep whenever every task is blocked.
CONFIG_PM_ENABLE=y
# While a computer is on the native USB port, stay out of light sleep so flashing and logs keep working.
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3

# BLE peripheral (NimBLE) with controller modem sleep so the radio sleeps between events.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
CONFIG_BT_CTRL_LPCLK_SEL_MAIN_XTAL=y
CONFIG_BT_CTRL_MAIN_XTAL_PU_DURING_LIGHT_SLEEP=y

# LVGL: one thread (ours), RGB565, refresh timer pauses itself when nothing changes.
# The simulator reports the heap peak (about 41 KB on a 64-bit host); 64 KB leaves headroom.
CONFIG_LV_COLOR_FORMAT_RGB565=y
CONFIG_LV_OS_NONE=y
CONFIG_LV_MEM_SIZE=65536
CONFIG_LV_DEF_REFR_PERIOD=33
CONFIG_LV_CACHE_DEF_SIZE=0
# Round line caps, card corners and arrow strokes use about a dozen circle radii; with fewer cache slots
# than that, every frame recomputed the anti-aliased circles (a riding frame took 4 ms longer).
CONFIG_LV_DRAW_SW_CIRCLE_CACHE_SIZE=16
